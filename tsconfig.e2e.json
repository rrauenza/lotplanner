{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    /* End-to-end tests are node programs that run fragments inside a browser,
       so this is the one project that legitimately has both. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["e2e/**/*.ts"]
}
